# App Settings
APP_NAME=Telegram Keyword Monitor
DEBUG=False
LOG_LEVEL=INFO

# Telegram Bot для уведомлений админа (необязательно)
# Создайте бота через @BotFather
TELEGRAM_BOT_TOKEN=111111111111111111111111
ADMIN_TELEGRAM_CHAT_ID=-111111111111111

# Sessions directory (внутри контейнера)
SESSIONS_DIR=/app/backend/sessions

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=telegram_monitor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security
SECRET_KEY=secretviW1Y56TyHYMhQkLDzDWH
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0


# Monitoring settings
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36
DEFAULT_CHECK_INTERVAL=300
DEFAULT_TIMEOUT=30
MAX_CONCURRENT_CHECKS=100
# 5 minutes проверять валидность аккаунтов
ACCOUNT_HEALTH_CHECK_INTERVAL=300

# Billing settings
# Cost for 5 accounts + 25 tasks (5*5)
# 10 minutes in seconds
MONTHLY_COST_MAX=1000.0
BALANCE_CHECK_INTERVAL=60
START_BALANCE=10

MAXIMUM_NUMBER_OF_ACCOUNTS=5
MAXIMUM_NUMBER_OF_TASKS=5
MAXIMUM_NUMBER_OF_CHANNELS=5

# YooKassa (ЮKassa) Payment Settings
# Получите данные в личном кабинете https://yookassa.ru/my
#YOOKASSA_SHOP_ID=111111 - тестовый
YOOKASSA_SHOP_ID=111111
YOOKASSA_SECRET_KEY=your_secret_key_here
# URL для возврата пользователя после оплаты
YOOKASSA_RETURN_URL=http://localhost:8080
# URL для уведомлений от ЮKassa (должен быть доступен из интернета)
YOOKASSA_WEBHOOK_URL=https://yourdomain.com/api/v1/payments/webhook

# Task limits
# максимум строк в белом/черном списке
MAX_KEYWORD_LINES=10
# максимум символов в одной строке ключевого слова
MAX_KEYWORD_LENGTH=50
# максимум строк замен
MAX_REPLACEMENT_LINES=10
# максимум символов в одной строке замены
MAX_REPLACEMENT_LENGTH=50