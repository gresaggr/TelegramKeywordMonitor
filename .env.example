# App Settings
APP_NAME=Telegram Keyword Monitor
DEBUG=False
LOG_LEVEL=INFO

# Telegram Bot для уведомлений админа (необязательно)
# Создайте бота через @BotFather
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=telegram_monitor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Security
SECRET_KEY=your_very_long_random_secret_key_here_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Sessions directory (внутри контейнера)
SESSIONS_DIR=/app/backend/sessions