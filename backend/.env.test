# backend/.env.test
# Test Environment Variables

# Database (SQLite for testing)
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security
SECRET_KEY=test_secret_key_for_testing_only_do_not_use_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Telegram (optional for tests)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# Billing
START_BALANCE=10
BALANCE_CHECK_INTERVAL=600
MONTHLY_COST_MAX=1000.0

# Limits
MAXIMUM_NUMBER_OF_ACCOUNTS=5
MAXIMUM_NUMBER_OF_TASKS=5
MAXIMUM_NUMBER_OF_CHANNELS=5

# YooKassa (optional for tests)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8080
YOOKASSA_WEBHOOK_URL=